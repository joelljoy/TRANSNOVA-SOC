# Copy to .env and replace every value. .env is git-ignored.
# Allowed characters in these passwords: letters, digits, _ # . -
MARIADB_ROOT_PASSWORD=change-me-root
CONTROLLER_DB_PASSWORD=change-me-controller
# The attacker-facing decoy password is meant to be guessable, but it is still set here so
# the repository holds no credential.
DECOY_DB_PASSWORD=change-me-decoy

# ---- TransNova SOC console (all optional) ----
# AI alert explanations. Read only by the console backend; never sent to the browser.
# Leave empty and the console says explanations are unavailable; nothing else changes.
ANTHROPIC_API_KEY=
SOC_AI_MODEL=claude-opus-5-5
# true only when the console is served over HTTPS.
SOC_COOKIE_SECURE=false

# Collector, console and SSH tokens and console accounts are NOT set here: they are Docker
# secrets in ./secrets, created by `python scripts/make_secrets.py`.
