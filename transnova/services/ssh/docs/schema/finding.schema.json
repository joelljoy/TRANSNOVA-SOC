{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ps04.finding.v0.1",
  "title": "PS04 detection finding (Cowrie SSH sensor) - PROPOSED, not yet agreed by the team",
  "type": "object",
  "required": [
    "record_type", "schema_version", "finding_id", "rule_id", "rule_name", "title", "severity",
    "confidence", "created_at", "first_seen", "last_seen", "source_service", "sensor_id",
    "session_ids", "attack", "evidence", "explanation"
  ],
  "properties": {
    "record_type": { "const": "finding" },
    "schema_version": { "const": "ps04.finding.v0.1" },
    "finding_id": { "type": "string", "format": "uuid", "description": "UUIDv5(sensor, rule, key); stable for the same detection" },
    "rule_id": { "type": "string", "examples": ["SSH-BRUTE-001"] },
    "rule_name": { "type": "string" },
    "title": { "type": "string" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "created_at": { "type": "string", "format": "date-time" },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "source_service": { "const": "ssh" },
    "sensor_id": { "type": "string" },
    "source_ip": { "type": ["string", "null"] },
    "session_ids": { "type": "array", "items": { "type": "string" } },
    "username": { "type": ["string", "null"] },
    "attack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["technique_id", "name", "tactic"],
        "properties": {
          "technique_id": { "type": "string" },
          "name": { "type": "string" },
          "tactic": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["event_ids", "event_count", "observed"],
      "properties": {
        "event_ids": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" }, "description": "event_id values of the supporting normalized events" },
        "event_count": { "type": "integer" },
        "observed": { "type": "object", "description": "Rule-specific observed values (counts, usernames, commands, paths, URLs)" },
        "window_seconds": { "type": ["number", "null"] },
        "threshold": {}
      }
    },
    "explanation": { "type": "string" },
    "recommended_action": { "type": "string" }
  }
}
