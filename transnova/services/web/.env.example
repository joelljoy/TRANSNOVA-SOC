# Web decoy configuration. ALL VALUES ARE SYNTHETIC LAB VALUES - never put real credentials here.
SENSOR_ID=web-01
WEB_DECOY_PORT=8080
# Synthetic decoy credential that the simulator uses to "succeed". It protects nothing real.
DECOY_USER=j.miller
DECOY_PASSWORD=TransNova#Spring26
# Sources allowed to see detailed /health (comma-separated CIDRs).
# Use single /32 addresses (e.g. the collector's fixed lab IP), NEVER the whole lab subnet:
# traffic through a published port arrives from the Docker gateway (172.28.0.1), so a
# /16 would trust every host-side request (PLAN.md §0.1 P9).
HEALTH_ALLOWED_CIDRS=127.0.0.1/32
# Used from Phase 3 onward:
COLLECTOR_URL=http://collector:8000/api/events
# The simulator must run as a container on lab_net with a fixed IP (see PLAN.md P9).
SIMULATOR_SOURCE_CIDRS=172.28.0.50/32
TRUST_PROXY=0
